# Copy to .env for `make run` / `make migrate-up`. Never commit .env.
# Passwords match platform-infrastructure/.env.example.

APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8090
ADMIN_ADDR=:8091
SHUTDOWN_TIMEOUT=15s

# Runtime role (row-level security applies).
DATABASE_URL=postgres://veritrace_telemetry_app:telemetry-app-dev@localhost:5432/veritrace_telemetry?sslmode=disable

# Schema owner role (migrations only).
MIGRATIONS_DATABASE_URL=postgres://veritrace_telemetry_owner:telemetry-owner-dev@localhost:5432/veritrace_telemetry?sslmode=disable

# Components this instance runs (ADR-0012): ingest, processor, or both.
COMPONENTS=ingest,processor

# Kafka bootstrap brokers, comma-separated.
KAFKA_BROKERS=localhost:9092

# MQTT broker of the ingest component. The password matches MQTT_INGEST_PASSWORD of platform-infrastructure.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=telemetry-ingest
MQTT_PASSWORD=ingest-dev
